.DS_Store
*.textClipping

# Papers and unpublished/review materials. Keep local only.
*.pdf

# Large raw videos. Keep these locally or use Git LFS / external storage.
*.mp4
*.avi
*.mov
*.mkv

# DeepLabCut generated outputs and caches.
dlc-models/
dlc-models-pytorch/
labeled-data/
videos/
evaluation-results/
training-datasets/
*.h5
*.pickle
*.csv
*.log

# Aggregated, publication-safe result tables are intentionally versioned.
!**/results/**/*.csv

# Python / notebook caches.
__pycache__/
.ipynb_checkpoints/
.venv/
venv/

# Temporary outputs.
local_data/
tmp/
output/

ai-notes/
meeting-notes/

# Per-task units: label tables and demo videos stay local
**/training-data/
**/logs/
**/predictions/
# location-independent since the 2026-09-20 reorganisation (old_pupil_top/, new_pupil_top_video_scaling/)
**/demo_clips/
**/active-learning*/branches/
**/active-learning*/frames/
**/pipeline_*/
